{
  "name": "tutor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:server": "cargo run -p tutor-server",
    "dev:web": "npm --workspace @ai/tutor run dev",
    "build": "cargo build --workspace --release && npm --workspace @ai/tutor run build",
    "generate:types": "cargo run -p tutor-server --bin export-types",
    "typecheck": "tsc --noEmit",
    "format": "cargo fmt --all && oxfmt --write .",
    "lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings && oxlint",
    "lint:fix": "oxlint --fix",
    "test": "cargo test --workspace && npm --workspaces --if-present test",
    "workspace:check": "npm --workspaces --if-present run check",
    "check": "npm run format && npm run lint:fix && npm run lint && npm run typecheck && npm run workspace:check && npm test && npm --workspace @ai/tutor run build"
  },
  "devDependencies": {
    "eslint-plugin-import": "^2.32.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
